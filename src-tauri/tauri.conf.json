{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mantel",
  "version": "../package.json",
  "identifier": "com.playmantel.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mantel",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 540,
        "fullscreen": true,
        "decorations": false,
        "backgroundColor": "#06070b",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "msix/AppxManifest.xml": "AppxManifest.xml",
      "msix/CustomCapability.SCCD": "CustomCapability.SCCD",
      "msix/home-app.ps1": "home-app.ps1",
      "icons/Square150x150Logo.png": "Assets/Square150x150Logo.png",
      "icons/Square44x44Logo.png": "Assets/Square44x44Logo.png",
      "icons/StoreLogo.png": "Assets/StoreLogo.png"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "msix/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxNTRCQkJEQzM3NTczNTUKUldSVmMzWER2YnRVMFNJWGlRVWcvZUlpYk5xTWdDZm5mUWcxSjZTTmVHcGNGL1hWWHMrbnN4em4K",
      "endpoints": [
        "https://github.com/jarto666/mantel/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
